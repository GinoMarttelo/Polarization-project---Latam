e,"Hidden":false},"Language":[],"DefaultChoices":false,"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1,"GradingData":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"OFF","Type":"None"}},"Selector":"TB"}},{"SurveyID":"SV_26xAq62rPM2ibI2","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"\u00bfEn qu\u00e9 medida considera que esta es una buena o mala raz\u00f3n para la posici\u00f3n indicada?","TertiaryAttribute":null,"Payload":{"QuestionID":"QID48","DataExportTag":"r09_quality","QuestionText":"\u00bfEn qu\u00e9 medida considera que esta es una buena o mala raz\u00f3n para la posici\u00f3n indicada?","QuestionDescription":"\u00bfEn qu\u00e9 medida considera que esta es una buena o mala raz\u00f3n para la posici\u00f3n indicada?","QuestionType":"Slider","DataVisibility":{"Private":false,"Hidden":false},"Language":[],"DefaultChoices":false,"ChoiceOrder":["1"],"NextChoiceId":2,"NextAnswerId":3,"GradingData":[],"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":0,"ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0.4981595092024539983555087019340135157108306884765625}},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Choices":{"1":{"Display":"&nbsp;"}},"RecodeValues":{"1":"1"},"Selector":"HSLIDER","Labels":{"1":{"Display":"0 \u2014 Una raz\u00f3n muy mala"},"2":{"Display":"100 \u2014 Una raz\u00f3n muy buena"}},"ChoiceDataExportTags":false}},{"SurveyID":"SV_26xAq62rPM2ibI2","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Raz\u00f3n 10 de 20 Afirmaci\u00f3n ${e:\/\/Field\/r10_statement} Posici\u00f3n que apoya la raz\u00f3n: ${e:\/\/Field\/r","TertiaryAttribute":null,"Payload":{"QuestionID":"QID49","DataExportTag":"r10_display","QuestionText":"<h3>Raz\u00f3n 10 de 20<\/h3><p><strong>Afirmaci\u00f3n<\/strong><\/p><blockquote>${e:\/\/Field\/r10_statement}<\/blockquote><p><strong>Posici\u00f3n que apoya la raz\u00f3n:<\/strong> ${e:\/\/Field\/r10_side_label} con la afirmaci\u00f3n.<\/p><p><strong>Raz\u00f3n<\/strong><\/p><div class=\"reason-text\">${e:\/\/Field\/r10_text}<\/div>","QuestionDescription":"Raz\u00f3n 10 de 20 Afirmaci\u00f3n ${e:\/\/Field\/r10_statement} Posici\u00f3n que apoya la raz\u00f3n: ${e:\/\/Field\/r","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Language":[],"DefaultChoices":false,"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1,"GradingData":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"OFF","Type":"None"}},"Selector":"TB"}},{"SurveyID":"SV_26xAq62rPM2ibI2","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Formulario de consentimiento para investigaci\u00f3n con participantes humanos T\u00edtulo del estudio: Raz.","TertiaryAttribute":null,"Payload":{"QuestionID":"QID5","DataExportTag":"consent_info","QuestionText":"<h3>Formulario de consentimiento para investigaci\u00f3n con participantes humanos<\/h3><div><br><\/div>\n<p><strong>T\u00edtulo del estudio:<\/strong> Razones de las creencias pol\u00edticas<\/p>\n<p><br><\/p><p>Este formulario le invita a participar en un estudio dirigido por Samuel Murray, Ph.D., profesor asistente del Departamento de Filosof\u00eda de Providence College, con colaboraci\u00f3n local de Gino Carmona D\u00edaz.<\/p>\n<p><strong><br><\/strong><\/p><p><strong>Objetivo.<\/strong> Buscamos comprender c\u00f3mo las personas justifican sus opiniones sobre temas sociales y pol\u00edticos.<\/p>\n<p><strong><br><\/strong><\/p><p><strong>Qu\u00e9 se le pedir\u00e1.<\/strong> En una sesi\u00f3n en l\u00ednea de aproximadamente 10 minutos,&nbsp;completar\u00e1 una encuesta de cuatro componentes en la que expresar\u00e1 sus opiniones pol\u00edticas, evaluar\u00e1 20 razones dadas por otras personas, responder\u00e1 preguntas sobre distintos grupos pol\u00edticos y finalmente responder\u00e1 algunas preguntas sociodemogr\u00e1ficas. Su participaci\u00f3n es voluntaria y puede abandonar el estudio en cualquier momento cerrando la ventana del navegador.<\/p>\n<p><strong><br><\/strong><\/p><p><strong>Confidencialidad y uso futuro.<\/strong> No solicitaremos su nombre. Los datos desidentificados, sin direcci\u00f3n IP ni identificador del panel, podr\u00e1n compartirse con otros investigadores, ponerse a disposici\u00f3n p\u00fablica cuando corresponda o utilizarse en investigaciones futuras.<\/p>\n<p><strong><br><\/strong><\/p><p><strong>Riesgos y beneficios.<\/strong> No hay beneficios directos. Algunas preguntas pol\u00edticas pueden producir una incomodidad leve. Fuera de ello, no se conocen riesgos adicionales.<\/p>\n<p><br><\/p><p>Si tiene preguntas sobre la investigaci\u00f3n, escriba a Gino Carmona D\u00edaz (g.carmona@uniandes.edu.co). Para preguntas sobre sus derechos como participante, escriba al Comit\u00e9 de \u00c9tica en Investigaci\u00f3n de Providence College (irb@providence.edu) e indique el protocolo FY26-99.<\/p>\n<p><br><\/p><p>Al seleccionar \u201cAcepto participar\u201d, confirma que tiene 18 a\u00f1os o m\u00e1s, comprende la informaci\u00f3n anterior y acepta participar voluntariamente. No renuncia a ning\u00fan derecho legal.<\/p><p>Registraremos qu\u00e9 razones se le muestran, sus evaluaciones y el tiempo de respuesta. Las razones se seleccionar\u00e1n al azar entre los temas en los que usted indique acuerdo o desacuerdo. Responda con sinceridad; no cambie sus opiniones para continuar.<\/p>","QuestionDescription":"Formulario de consentimiento para investigaci\u00f3n con participantes humanos T\u00edtulo del estudio: Raz...","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Language":[],"DefaultChoices":false,"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1,"GradingData":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"Type":"None"}},"Selector":"TB"}},{"SurveyID":"SV_26xAq62rPM2ibI2","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"\u00bfEn qu\u00e9 medida considera que esta es una buena o mala raz\u00f3n para la posici\u00f3n indicada?","TertiaryAttribute":null,"Payload":{"QuestionID":"QID50","DataExportTag":"r10_quality","QuestionText":"\u00bfEn qu\u00e9 medida considera que esta es una buena o mala raz\u00f3n para la posici\u00f3n indicada?","QuestionDescription":"\u00bfEn qu\u00e9 medida considera que esta es una buena o mala raz\u00f3n para la posici\u00f3n indicada?","QuestionType":"Slider","DataVisibility":{"Private":false,"Hidden":false},"Language":[],"DefaultChoices":false,"ChoiceOrder":["1"],"NextChoiceId":2,"NextAnswerId":3,"GradingData":[],"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":0,"ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0.4969325153374233305925145032233558595180511474609375}},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Choices":{"1":{"Display":"&nbsp;"}},"RecodeValues":{"1":"1"},"Selector":"HSLIDER","Labels":{"1":{"Display":"0 \u2014 Una raz\u00f3n muy mala"},"2":{"Display":"100 \u2014 Una raz\u00f3n muy buena"}},"ChoiceDataExportTags":false}},{"SurveyID":"SV_26xAq62rPM2ibI2","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"Raz\u00f3n 11 de 20 Afirmaci\u00f3n ${e:\/\/Field\/r11_statement} Posici\u00f3n que apoya la raz\u00f3n: ${e:\/\/Field\/r","TertiaryAttribute":null,"Payload":{"QuestionID":"QID51","DataExportTag":"r11_display","QuestionText":"<h3>Raz\u00f3n 11 de 20<\/h3><p><strong>Afirmaci\u00f3n<\/strong><\/p><blockquote>${e:\/\/Field\/r11_statement}<\/blockquote><p><strong>Posici\u00f3n que apoya la raz\u00f3n:<\/strong> ${e:\/\/Field\/r11_side_label} con la afirmaci\u00f3n.<\/p><p